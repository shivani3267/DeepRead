PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Internal Security Key (Must match server INTERNAL_SERVICE_KEY)
INTERNAL_SERVICE_KEY=deepread_internal_secure_api_key_89234719

# Primary LLM Provider: 'gemini' (or 'ollama', 'openai', 'mock')
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Obtain free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embedding Provider: 'gemini' (online), 'huggingface' (online), 'local'
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768

# Optional HuggingFace Online Inference API Key
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Database (Pinecone)
# Set your Pinecone API Key below. If left empty, DeepRead uses its built-in local vector adapter for testing
PINECONE_API_KEY=
PINECONE_INDEX_NAME=deepread-academic
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Chunking Configuration
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Answerability Threshold
ANSWERABILITY_SIMILARITY_THRESHOLD=0.58
