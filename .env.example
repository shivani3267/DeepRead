# ====================================================================
# DeepRead Unified Environment Reference
# ====================================================================
# This file provides a centralized overview of environment variables
# required across the server, AI microservice, and frontend client.
#
# Copy relevant portions to:
#   - DeepRead/server/.env
#   - DeepRead/ai-service/.env
#   - DeepRead/client/.env
# ====================================================================

# --------------------------------------------------------------------
# 1. Express Backend Server (server/.env)
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/DeepRead?retryWrites=true&w=majority
JWT_SECRET=super_secure_deepread_production_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_KEY=deepread_internal_secure_api_key_89234719

# --------------------------------------------------------------------
# 2. FastAPI AI Microservice (ai-service/.env)
# --------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
INTERNAL_SERVICE_KEY=deepread_internal_secure_api_key_89234719

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embeddings & Vector Database
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=deepread-academic
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG Pipeline Tuning
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
ANSWERABILITY_SIMILARITY_THRESHOLD=0.58

# --------------------------------------------------------------------
# 3. React Vite Frontend Client (client/.env)
# --------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
